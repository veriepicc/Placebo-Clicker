project Ada_Clicker is

   for Source_Dirs use ("src", "src/spark", "src/os", "src/ui");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("main.adb");

    for Languages use ("Ada");

    package Compiler is
      for Default_Switches ("Ada") use (
        "-gnat2022",
        "-gnata",
        "-gnatVa",
        "-gnato",
        "-gnatE",
        "-gnatH",
        "-gnatW8",
        "-gnatf",
        "-gnatU",
        "-gnatVao",
        "-gnatj55",
        "-gnatwa",
        "-gnatw.A",
        "-gnatwE",
        "-gnatwe",
        "-gnaty", "-gnaty3",
        "-gnatya", "-gnatyb", "-gnatyc", "-gnatyd",
        "-gnatye", "-gnatyf", "-gnatyh", "-gnatyi",
        "-gnatyk", "-gnatyl", "-gnatym", "-gnatyn",
        "-gnatyo", "-gnatyp", "-gnatyr", "-gnatys",
        "-gnatyt", "-gnatyu", "-gnatyx",
        "-Os",
        "-ffunction-sections",
        "-fdata-sections",
        "-fstack-protector-strong",
        "-Wextra", "-Wall", "-Werror"
      );
   end Compiler;

   package Prove is
      for Proof_Switches ("Ada") use (
        "--level=4",
        "--mode=all",
        "--timeout=10",
        "--memlimit=2000",
        "--steps=5000",
        "--prover=cvc5,z3,altergo",
        "--proof=progressive",
        "--report=all",
        "--warnings=error",
        "--cwe",
        "--assumptions",
        "--proof-warnings"
      );
      for Excluded_Source_Files use ("main.adb");
   end Prove;

   package Binder is
      for Default_Switches ("Ada") use ("-E");
   end Binder;

   package Builder is
      for Executable ("main.adb") use "placebo";
   end Builder;

   --  no cmd window, gui subsystem only, strip dead code
   --  note: no --gc-sections, it eats the .rsrc icon section lmao
   package Linker is
      for Default_Switches ("Ada") use
        ("-mwindows", "-s", Ada_Clicker'Project_Dir & "obj/icon.o");
   end Linker;

end Ada_Clicker;
